# SkillBridge backend environment variables
# Copy this file to .env and fill in real values. Never commit .env to Git.

# Port the Express server listens on
PORT=4000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=skill_swap_network

# Secret used to sign JWTs - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_string

# Allowed CORS origin (the Vite dev server)
CLIENT_URL=http://localhost:5173
